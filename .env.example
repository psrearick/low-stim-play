APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=low_stim_play
DB_USERNAME=low_stim
DB_PASSWORD=secret

SESSION_DRIVER=redis
# 1 year -- this app wants users to stay signed in for a long time rather
# than expiring on any particular idle schedule; see docs/DEVLOG.md.
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

REVERB_APP_ID=471852
REVERB_APP_KEY=lspreverbkey
REVERB_APP_SECRET=lspreverbsecret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# In production (Laravel Cloud), set these two as real environment variables
# in the Cloud dashboard instead -- not here -- and get RESEND_API_KEY from
# resend.com. Locally, MAIL_MAILER=log above just writes emails (including
# the verification link) to storage/logs/laravel.log instead of sending them.
# MAIL_MAILER=resend
# RESEND_API_KEY=

# Used by avatar image uploads (Storage::disk('s3')) -- see docs/DEVLOG.md's
# "Authentication & passkeys" section for the S3-compatible bucket this
# app actually uses.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPENROUTER_API_KEY=

# Comma-separated allow-list for the /analytics dashboard's 'view-analytics'
# gate -- this app has no is_admin column or other admin concept, so this
# is the whole access-control story. See docs/specs/analytics.md.
ANALYTICS_ADMIN_EMAILS=

# From a MaxMind account (maxmind.com) -- used by `analytics:geoip-update`
# to download the GeoLite2-City database ANALYTICS_GEO_DRIVER=maxmind
# reads locally. Leaving these blank means the countries/regions panels
# stay empty until they're set and the command has been run at least once.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
