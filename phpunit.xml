<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            Boggle's Solver builds an ~80k-word dictionary per test process
            (it's bound as a container singleton, but Laravel's TestCase
            boots a fresh application per test, so it's rebuilt often). At
            ~30MB a time across a whole test file, plus Xdebug's overhead
            when enabled, this can exceed PHP CLI's 128M default and fail
            with an unhelpful empty/truncated test run rather than a clear
            error. 512M gives comfortable headroom.
        -->
        <ini name="memory_limit" value="512M"/>
        <!--
            docker-compose.yml sets a real container-level APP_ENV=local, for
            `composer run dev`/`artisan serve` etc, so PHPUnit's own <env>
            override alone doesn't beat that: Laravel's env() resolution
            reads $_SERVER, populated from the container's real environment at
            PHP startup, which <env> never touches. force="true" also makes
            PHPUnit override an already-set OS env var via putenv()/$_ENV
            (its default behavior otherwise leaves an existing one alone),
            and the <server> entry below covers the $_SERVER copy too.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!--
            Not "after_response" (the app's own default): Laravel's
            Application::terminate() never clears its own $terminatingCallbacks
            list after running them (see vendor/laravel/framework/src/
            Illuminate/Foundation/Application.php), so a job dispatched via
            ->afterResponse() (which registers itself through that same
            mechanism) re-fires on every later terminate() call within the
            same process. Harmless in this app's real deployment (a fresh
            PHP-FPM process per request on Laravel Cloud, no Octane), but a
            single test method making two or more sequential HTTP calls
            reuses one Application instance for its whole duration, so the
            first request's analytics job would silently re-run and
            duplicate its row on every subsequent request in that same test.
            "queue" dispatches through Bus::dispatch() directly instead,
            which QUEUE_CONNECTION=sync above still runs synchronously, just
            without that accumulating-callback behavior.
        -->
        <env name="ANALYTICS_DISPATCH" value="queue"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
