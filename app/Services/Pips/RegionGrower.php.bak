<?php

namespace App\Services\Pips;

use Random\Randomizer;

/**
 * Partitions a board's cells into contiguous regions covering the whole
 * board with no gaps/overlaps -- the "randomized flood-fill/region-growing
 * pass" docs/specs/pips.md section 3 calls for. Geometry only, no pip
 * values: constraints are derived afterward by ConstraintDeriver from
 * whatever BoardFiller's solution happens to hold inside each region.
 *
 * Coverage is guaranteed by mopUp()'s own loop condition (it doesn't stop
 * until zero cells are unclaimed). Connectivity is guaranteed by
 * construction, not checked after the fact: a cell is only ever added to a
 * region because it is adjacent to a cell that region already owns (either
 * popped from that region's own frontier queue, or claimed in mopUp() via
 * an already-owned neighbor) -- there is no code path that could disconnect
 * a region's existing footprint once claimed, since claims are permanent.
 */
class RegionGrower
{
    private const MIN_REGION_SIZE = 1;

    private const MAX_REGION_SIZE = 6;

    /**
     * @return array<int, list<int>>
     */
    public function grow(Randomizer $randomizer, int $rows, int $cols): array
    {
        $neighbors = Grid::neighbors($rows, $cols);
        $cellCount = $rows * $cols;

        [$minRegions, $maxRegions] = $this->regionCountBounds($cellCount);
        $regionCount = $randomizer->getInt($minRegions, $maxRegions);

        $seeds = array_slice($randomizer->shuffleArray(range(0, $cellCount - 1)), 0, $regionCount);

        /** @var array<int, int|null> $owner */
        $owner = array_fill(0, $cellCount, null);
        $regions = [];
        $frontiers = [];
        $caps = [];
        $dormant = [];

        foreach (array_values($seeds) as $regionId => $seedCell) {
            $owner[$seedCell] = $regionId;
            $regions[$regionId] = [$seedCell];
            $frontiers[$regionId] = $neighbors[$seedCell];
            $caps[$regionId] = $randomizer->getInt(self::MIN_REGION_SIZE, self::MAX_REGION_SIZE);
            $dormant[$regionId] = false;
        }

        $this->growRegions($randomizer, $neighbors, $owner, $regions, $frontiers, $caps, $dormant, $regionCount);
        $this->mopUp($randomizer, $neighbors, $owner, $regions);

        return $regions;
    }

    /**
     * @return array{0: int, 1: int}
     */
    private function regionCountBounds(int $cellCount): array
    {
        $min = max(4, intdiv($cellCount, 6));
        $max = max($min + 1, intdiv($cellCount, 3));

        return [$min, $max];
    }

    /**
     * Round-robin growth: every non-dormant region tries to claim one more
     * cell from its own frontier each pass (a stale, already-claimed
     * candidate is simply discarded, not retried within the same pass -- it
     * just costs that region a turn), reshuffling region order every pass
     * so no region systematically goes first. A region goes dormant once
     * its frontier runs dry or it hits its soft size cap.
     *
     * @param  array<int, list<int>>  $neighbors
     * @param  array<int, int|null>  $owner
     * @param  array<int, list<int>>  $regions
     * @param  array<int, list<int>>  $frontiers
     * @param  array<int, int>  $caps
     * @param  array<int, bool>  $dormant
     */
    private function growRegions(Randomizer $randomizer, array $neighbors, array &$owner, array &$regions, array &$frontiers, array $caps, array &$dormant, int $regionCount): void
    {
        while (in_array(false, $dormant, true)) {
            foreach ($randomizer->shuffleArray(range(0, $regionCount - 1)) as $regionId) {
                if ($dormant[$regionId]) {
                    continue;
                }

                while ($frontiers[$regionId] !== []) {
                    $cell = array_shift($frontiers[$regionId]);

                    if ($owner[$cell] !== null) {
                        continue;
                    }

                    $owner[$cell] = $regionId;
                    $regions[$regionId][] = $cell;

                    foreach ($neighbors[$cell] as $neighbor) {
                        if ($owner[$neighbor] === null) {
                            $frontiers[$regionId][] = $neighbor;
                        }
                    }

                    break;
                }

                if ($frontiers[$regionId] === [] || count($regions[$regionId]) >= $caps[$regionId]) {
                    $dormant[$regionId] = true;
                }
            }
        }
    }

    /**
     * Assigns every cell the growth phase left unclaimed to a random
     * already-claimed neighboring region, ignoring each region's soft cap
     * (coverage correctness outranks the cosmetic size target) -- repeats
     * until nothing is left unclaimed, which must terminate in a finite
     * number of passes since the board is a single connected component and
     * at least one cell is already claimed (from growRegions()'s seeds).
     *
     * @param  array<int, list<int>>  $neighbors
     * @param  array<int, int|null>  $owner
     * @param  array<int, list<int>>  $regions
     */
    private function mopUp(Randomizer $randomizer, array $neighbors, array &$owner, array &$regions): void
    {
        $unclaimed = array_keys(array_filter($owner, fn (?int $regionId) => $regionId === null));

        while ($unclaimed !== []) {
            $stillUnclaimed = [];

            foreach ($unclaimed as $cell) {
                $claimedNeighborRegions = array_values(array_filter(
                    array_map(fn (int $n) => $owner[$n], $neighbors[$cell]),
                    fn (?int $regionId) => $regionId !== null,
                ));

                if ($claimedNeighborRegions === []) {
                    $stillUnclaimed[] = $cell;

                    continue;
                }

                $regionId = $claimedNeighborRegions[$randomizer->getInt(0, count($claimedNeighborRegions) - 1)];
                $owner[$cell] = $regionId;
                $regions[$regionId][] = $cell;
            }

            $unclaimed = $stillUnclaimed;
        }
    }
}
